# Un .env par machine (spec 52, D136) : celui du PC (développement) et celui du VPS (production) ne sont jamais copiés
# l'un vers l'autre ni versionnés. Sauf mention, une variable a le même rôle sur les deux ; ses valeurs diffèrent.
# Clé de l'API Claude — Console Anthropic, page API Keys.
ANTHROPIC_API_KEY=
# Modèle Claude retenu par mesure — résultat de la mesure D15 (`cd serveur && npm run comprendre:jeu`, spec 28) ; un de : claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, claude-opus-5, claude-sonnet-5. Les trois variables Claude se remplissent ensemble ou restent toutes vides.
CLAUDE_MODEL=
# Plafond mensuel de coût Claude en euros — choisi par toi (D15).
CLAUDE_PLAFOND_MENSUEL_EUR=
# Empreintes des clés d'appareil autorisées — calculées à partir des clés que tu génères pour chaque téléphone (A19).
CLES_APPAREILS=
# Nombre maximal de requêtes par minute et par clé d'appareil — choisi par toi.
LIMITE_REQ_MINUTE=
# Nombre maximal de requêtes par jour et par clé d'appareil — choisi par toi.
LIMITE_REQ_JOUR=
# Adresse interne de MOTIS — nom du service et port déclarés dans le docker compose.
MOTIS_URL=
# Source officielle du GTFS SNCF national — fiche du jeu sur transport.data.gouv.fr.
GTFS_SNCF_URL=
# Source officielle du GTFS des cars Mobigo (Yonne) — fiche du jeu sur transport.data.gouv.fr.
GTFS_MOBIGO_URL=
# Source officielle du temps réel GTFS-RT SNCF — fiche du jeu sur transport.data.gouv.fr.
GTFS_RT_SNCF_URL=
# DSN Sentry du serveur — Sentry, projet serveur, Settings > Client Keys (DSN). PC : facultatif. VPS : obligatoire (docker-compose.prod.yml).
SENTRY_DSN_SERVEUR=
# Environnement Sentry du serveur — PC : dev (ou vide). VPS : sans effet, docker-compose.prod.yml impose prod.
SENTRY_ENVIRONNEMENT=
# Clé d'événements Inngest — la même que celle passée à la configuration du serveur Inngest auto-hébergé.
INNGEST_EVENT_KEY=
# Clé de signature Inngest — la même que celle passée à la configuration du serveur Inngest auto-hébergé.
INNGEST_SIGNING_KEY=
# Jeton pour l'envoi Expo Push sécurisé — expo.dev, Account settings > Access tokens.
EXPO_ACCESS_TOKEN=
# Adresse de l'API lue par l'app au build (non secrète) — sur le PC : http://localhost:3000, avec `adb reverse tcp:3000 tcp:3000` à chaque branchement du téléphone (D63) ; plus tard, l'URL HTTPS de l'API sur le VPS.
EXPO_PUBLIC_API_URL=
# DSN Sentry de l'app, lu au build (non secret) — Sentry, projet app, Settings > Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
# URL du style des tuiles OpenFreeMap, lue au build — openfreemap.org, page Quick Start.
EXPO_PUBLIC_TUILES_URL=
# Jeton d'envoi des source maps au build de l'app — Sentry, Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
# Étiquette de l'image de l'API — VPS seulement : choisie à chaque déploiement (ex. 2026.11.07-1), jamais latest ; le compose de prod refuse de démarrer sans elle (phase 10).
ITINHERO_VERSION=
# Projet Docker de l'ingestion nocturne (scripts/ingestion-nuit.sh) — PC : vide (itinhero-national). VPS : itinhero-prod.
ITINHERO_PROJET=
