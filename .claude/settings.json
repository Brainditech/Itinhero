{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.dev)",
      "Read(.env.development)",
      "Read(.env.prod)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.dev)",
      "Edit(.env.development)",
      "Edit(.env.prod)",
      "Edit(.env.production)",
      "Edit(.env.test)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(npx expo lint *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm test *)",
      "Bash(npm run typecheck *)"
    ]
  }
}
