# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
# Modules natifs locaux (spec 23) : seules les sources sont versionnées
/modules/*/android/build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# secrets — jamais dans le dépôt
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# captures de preuve : gardées sur le PC, jamais versionnées (D38)
/docs/preuves/
# captures adb et d'écran : seul endroit autorisé, jamais versionnées (D93)
/docs/screenshots/

# Android Studio
/.idea/

# serveur (spec 04)
/serveur/node_modules/
/serveur/dist/

# téléchargements locaux (extrait Geofabrik Bourgogne, 200 Mo, D41)
/.cache/

# données nationales chargées dans MOTIS sur le PC (spec 08) — jamais dans le dépôt
/donnees/
